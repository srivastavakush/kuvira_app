# Never put real values in this file. Store production secrets in Secret
# Manager and inject them into Cloud Run as environment variables.
APP_ENV=production
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=kuchu_puchu
JWT_SECRET=replace-with-a-unique-32-plus-character-secret
# Optional local-network fallback for an ISP/router that blocks Atlas SRV
# lookups. Keep this empty in normal and production deployments.
MONGO_DIRECT_HOSTS=
MONGO_REPLICA_SET=

# Explicit public web origins only. Expo Go/native traffic does not use CORS.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Phone verification. Use one real provider; mock is development-only.
OTP_PROVIDER=firebase
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE=

# A real gateway integration is required before paid actions go live.
# PayU Hosted Checkout. Use newly rotated values in Secret Manager, never in
# the mobile app, repository, or a public callback URL.
PAYMENT_PROVIDER=payu
PAYU_MODE=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_CALLBACK_BASE_URL=https://api.example.com
# Optional overrides; defaults are test.payu.in and secure.payu.in by mode.
PAYU_CHECKOUT_URL=
PAYU_VERIFY_URL=

# GCS: Cloud Run's service account needs storage.objectAdmin on this bucket.
AI_COACH_STORAGE_BACKEND=gcs
AI_COACH_STORAGE_BUCKET=your-private-ai-coach-videos-bucket
AI_COACH_STORAGE_PREFIX=ai-coach/videos
AI_COACH_MAX_VIDEO_MB=500

# Vertex AI uses Application Default Credentials from the Cloud Run service
# account. Do not set a browser/mobile API key for this.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=asia-south1
AI_PROVIDER=vertex
VERTEX_AI_MODEL_PRIMARY=gemini-2.5-flash
VERTEX_AI_MODEL_SECONDARY=gemini-2.5-flash
VERTEX_AI_VIDEO_MODEL=gemini-2.5-flash
VERTEX_AI_EMBEDDING_MODEL=text-embedding-005
# Optional but recommended on Atlas: enables scalable semantic retrieval.
# Create the matching index in AI_COACH_RAG.md before setting this value.
AI_COACH_VECTOR_INDEX=ai_coach_knowledge_vector
AI_COACH_EMBED_BATCH_SIZE=32
AI_COACH_ANALYZER=vertex_gemini

# API and worker must be independent Cloud Run services. The worker reads the
# durable Mongo jobs collection and should have a minimum instance or schedule.
AI_COACH_QUEUE_BACKEND=worker
AI_COACH_RATE_LIMIT_BACKEND=mongo
AI_COACH_RATE_LIMIT_FAIL_CLOSED=true
AI_COACH_JOB_RETRIES=3
AI_COACH_JOB_MAX_ATTEMPTS=5
