{
  "expo": {
    "name": "MatchDrome",
    "slug": "kuchu-puchu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["kuchupuchu", "matchdrome"],
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.kuvirasportsapp.zwrxyl"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFDF8"
      },
      "package": "com.emergent.kuvirasportsapp.zwrxyl"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "MatchDrome uses your photo library only when you choose a profile photo or match video."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFDF8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
